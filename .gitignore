# This repo is the kit. A clone should contain the loop, the skills, and a blank
# spec form — not a product spec, the live board, or local secrets.
#
# Allowlist: markdown, the license, harness/, scripts/, acceptance tests, and
# the skill symlinks. Everything else stays untracked until you decide a product
# belongs in this tree. The blocks at the bottom stay ignored even after that
# allowlist is narrowed.

*
!*/

!.gitignore

!*.md
!**/*.md

!LICENSE
!.claude/skills
!.cursor/skills

!harness/**
!scripts/**

# Human-written acceptance tests are part of the oracle. Track every file here,
# not only markdown, so the tamper check can see edits.
!/tests/acceptance/**

# When a product lives in this tree, un-ignore only its source.
# Example for a TypeScript + Vite app:
# !/package.json
# !/package-lock.json
# !/tsconfig.json
# !/vite.config.ts
# !/index.html
# !/src/**
# !/tests/**

# Install and build output stay untracked.
node_modules/
dist/
.venv/
__pycache__/

# Coordination state stays out of git, including markdown task files.
.factory/

# Secrets stay untracked. .env.example is names only and is tracked.
.env
.env.*
!.env.example

# Working spec. The blank kit copy is templates/SPEC.md.
/SPEC.md
