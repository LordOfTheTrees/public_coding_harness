# Names the harness reads from the environment. Leave values empty in git.
# The loop does not source .env. Export its knobs in the shell.
# harness/jev.sh reads TYPESAFE_API_KEY from the environment or from .env.
# Never commit a real key.

AGENT_CLI=
AGENT_TIMEOUT=
MODEL_PLANNER=
MODEL_WORKER=
MODEL_EVALUATOR=
MODEL_CLEANER=
MAX_ITERS=
MAX_ATTEMPTS=
CLEAN_EVERY=
MAIN_BRANCH=

# Optional. jev.sh reads these. The keep-building check uses the same key
# lookup and stays off when TYPESAFE_API_KEY is unset.
# JEV_GATE=on|off (default on when a key exists).
# JEV_MODE=enforce|log (default log). JEV_DONE_AUTHORITY=both|planner|jev (default both).
# JEV_CONTINUE_THRESHOLD defaults to 0.5. JEV_STATE_TOKEN_BUDGET defaults to 24000.
# JEV_EXTEND_ITERS defaults to 0. JEV_MOCK_NOUL answers with no network call.
# JEV_MODEL defaults to jev-latest. Names only. Never commit a real key.
TYPESAFE_API_KEY=
JEV_MODEL=
TYPESAFE_API_URL=
JEV_GATE=
JEV_MODE=
JEV_DONE_AUTHORITY=
JEV_CONTINUE_THRESHOLD=
JEV_STATE_TOKEN_BUDGET=
JEV_EXTEND_ITERS=
JEV_MOCK_NOUL=
